---
import { CATEGORIES } from '../config';

interface Props {
  selected?: string;
}

const { selected } = Astro.props;
---

<div class="category-filter">
  <h2 class="category-heading">Categories</h2>

  <div class="category-list">
    <!-- All Posts button -->
    <button
      class={`category-button ${!selected ? 'active' : ''}`}
      data-category="all"
      aria-label="View all posts"
    >
      All Posts
    </button>

    <!-- Category buttons -->
    {
      CATEGORIES.map((category) => (
        <button
          class={`category-button ${selected === category ? 'active' : ''}`}
          data-category={category}
          aria-label={`Filter by ${category}`}
        >
          {category}
        </button>
      ))
    }
  </div>
</div>

<style>
  .category-filter {
    width: 100%;
    background-color: #1a1a1a;
    border: 1px solid #333333;
    border-radius: 0.5rem;
    padding: 1rem;
  }

  .category-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: #999999;
    margin: 0 0 0.875rem 0;
    padding: 0;
  }

  .category-list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .category-button {
    padding: 0.625rem 0.875rem;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 0.375rem;
    color: #d4d4d4;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease-out;
    font-family: inherit;
  }

  .category-button:hover {
    background-color: #242424;
    border-color: #3a3a3a;
    color: #e0e0e0;
  }

  .category-button.active {
    background-color: #ff9500;
    color: #0f0f0f;
    font-weight: 600;
    border-color: #ff9500;
    box-shadow: 0 0 8px rgba(255, 149, 0, 0.2);
  }

  .category-button.active:hover {
    background-color: #ffab1a;
    border-color: #ffab1a;
    box-shadow: 0 0 12px rgba(255, 149, 0, 0.3);
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .category-filter {
      background-color: transparent;
      border: none;
      padding: 0.5rem 0;
    }

    .category-list {
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.5rem;
    }

    .category-button {
      padding: 0.5rem 0.75rem;
      font-size: 0.85rem;
      flex: 1 1 auto;
      min-width: 70px;
      text-align: center;
    }
  }
</style>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const buttons = document.querySelectorAll('.category-button');

    buttons.forEach((button) => {
      button.addEventListener('click', () => {
        // Remove active class from all buttons
        buttons.forEach((btn) => btn.classList.remove('active'));

        // Add active class to clicked button
        button.classList.add('active');

        // You can add filtering logic here
        const category = button.getAttribute('data-category');
        console.log('Selected category:', category);

        // Dispatch custom event for filtering
        window.dispatchEvent(
          new CustomEvent('categorySelected', {
            detail: { category },
          })
        );
      });
    });
  });
</script>
