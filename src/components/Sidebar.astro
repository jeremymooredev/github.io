---
import PostFilters from './PostFilters.astro';
import KitSubscribeLink from './KitSubscribeLink.astro';
import { NEWSLETTER_CTA } from '../config';

interface Props {
  categories: string[];
  tags: string[];
}

const { categories, tags } = Astro.props;
---

<aside class="sidebar">
  <div class="sidebar-content">
    <div class="sidebar-section">
      <PostFilters categories={categories} tags={tags} />
    </div>

    <div class="sidebar-section newsletter-block">
      <h2 class="newsletter-heading">{NEWSLETTER_CTA.headline}</h2>
      <p class="newsletter-text">{NEWSLETTER_CTA.description}</p>
      <KitSubscribeLink class="btn-primary newsletter-link" />
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: 100%;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .sidebar-section {
    width: 100%;
  }

  .newsletter-block {
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 0.5rem;
    padding: 1rem;
  }

  .newsletter-heading {
    color: #b0b0b0;
    font-size: 0.9rem;
    font-weight: 600;
    margin: 0 0 0.5rem;
    line-height: 1.3;
  }

  .newsletter-text {
    color: #777;
    font-size: 0.75rem;
    margin: 0 0 0.875rem;
    line-height: 1.4;
  }

  .newsletter-link {
    display: block;
    width: 100%;
    text-align: center;
    text-decoration: none;
  }

  .newsletter-link:hover {
    text-decoration: none;
  }

  @media (min-width: 1024px) {
    .sidebar {
      width: 220px;
      position: sticky;
      top: 100px;
    }

    .sidebar-content {
      gap: 20px;
    }
  }

  @media (max-width: 1023px) {
    .sidebar {
      max-width: 100%;
    }

    .sidebar-content {
      gap: 20px;
    }
  }
</style>
