---
import NewsletterForm from './NewsletterForm.astro';
import CategoryFilter from './CategoryFilter.astro';

interface Props {
  selected?: string;
}

const { selected } = Astro.props;
---

<aside class="sidebar">
  <div class="sidebar-content">
    <!-- Categories -->
    <div class="sidebar-section">
      <CategoryFilter selected={selected} />
    </div>

    <!-- Newsletter -->
    <div class="sidebar-section">
      <NewsletterForm />
    </div>
  </div>
</aside>

<style>
  .sidebar {
    width: 100%;
  }

  .sidebar-content {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .sidebar-section {
    width: 100%;
  }

  /* Desktop - sticky sidebar */
  @media (min-width: 1024px) {
    .sidebar {
      width: 220px;
      position: sticky;
      top: 100px;
    }

    .sidebar-content {
      gap: 20px;
    }
  }

  /* Mobile - full width */
  @media (max-width: 1023px) {
    .sidebar {
      max-width: 100%;
    }

    .sidebar-content {
      gap: 20px;
    }
  }
</style>
