---
import { formatDate } from '../utils/formatting';
import { withBase } from '../utils/paths';

interface Props {
  title: string;
  excerpt: string;
  date: Date;
  category?: string;
  tags?: string[];
  image?: string;
  slug: string;
}

const { title, excerpt, date, category, tags = [], image, slug } = Astro.props;
---

<a
  href={withBase(`/blog/${slug}`)}
  class="blog-card-link"
  data-post-category={category ?? ''}
  data-post-tags={tags.join(',')}
>
  <article class="blog-card">
    <div class="blog-content">
      <h3 class="blog-title">{title}</h3>
      <p class="blog-excerpt">{excerpt}</p>
      <div class="blog-meta">
        <span class="meta-date">{formatDate(date)}</span>
        {category && <span class="meta-category">{category}</span>}
      </div>
    </div>

    {image && (
      <div class="blog-image-container">
        <img
          src={image}
          alt={title}
          class="blog-image"
        />
      </div>
    )}
  </article>
</a>

<style>
  .blog-card-link {
    text-decoration: none;
    color: inherit;
    display: block;
  }

  .blog-card {
    display: flex;
    gap: 20px;
    align-items: flex-start;
    padding: 16px;
    background: #1a1a1a;
    border: 1px solid #333333;
    border-radius: 8px;
    transition: all 0.3s ease;
  }

  .blog-card:hover {
    border-color: #ff9500;
    box-shadow: 0 4px 12px rgba(255, 149, 0, 0.15);
  }

  .blog-card:hover .blog-title {
    color: #ff9500;
  }

  .blog-content {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 10px;
    justify-content: space-between;
    min-height: 160px;
  }

  .blog-title {
    font-size: 1.15rem;
    font-weight: 600;
    color: #e0e0e0;
    margin: 0;
    line-height: 1.4;
    transition: color 0.2s ease;
  }

  .blog-excerpt {
    color: #b0b0b0;
    font-size: 0.95rem;
    margin: 0;
    line-height: 1.5;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
    flex-grow: 1;
  }

  .blog-meta {
    display: flex;
    gap: 12px;
    align-items: center;
    font-size: 0.9rem;
    margin-top: auto;
  }

  .meta-date {
    color: #999;
  }

  .meta-category {
    background: rgba(255, 149, 0, 0.2);
    color: #ff9500;
    padding: 2px 8px;
    border-radius: 4px;
    font-weight: 500;
    font-size: 0.85rem;
  }

  .blog-image-container {
    flex-shrink: 0;
    width: 160px;
    height: 160px;
    border-radius: 6px;
    overflow: hidden;
    background: #0f0f0f;
  }

  .blog-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.2s ease;
  }

  .blog-card:hover .blog-image {
    transform: scale(1.05);
  }

  /* Mobile layout: stack vertically */
  @media (max-width: 768px) {
    .blog-card {
      flex-direction: column;
      gap: 16px;
    }

    .blog-image-container {
      width: 100%;
      height: 200px;
    }

    .blog-title {
      font-size: 1.1rem;
    }
  }
</style>
