---
interface Props {
  placeholder?: string;
}

const { placeholder = 'Search posts...' } = Astro.props;
---

<div class="search-wrapper">
  <input
    type="text"
    placeholder={placeholder}
    class="search-input"
    aria-label="Search"
  />
  <svg
    class="search-icon"
    width="20"
    height="20"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <circle cx="11" cy="11" r="8"></circle>
    <path d="m21 21-4.35-4.35"></path>
  </svg>
</div>

<style>
  .search-wrapper {
    position: relative;
    width: 100%;
    max-width: 100%;
  }

  .search-input {
    width: 100%;
    padding: 12px 16px 12px 16px;
    background: #1a1a1a;
    border: 1px solid #333333;
    border-radius: 8px;
    color: #e0e0e0;
    font-size: 1rem;
    font-family: inherit;
    transition: all 0.2s ease;
    box-sizing: border-box;
  }

  .search-input::placeholder {
    color: #888888;
  }

  .search-input:focus {
    outline: none;
    border-color: #ff9500;
    background: #1f1f1f;
    box-shadow: 0 0 0 2px rgba(255, 149, 0, 0.1);
  }

  .search-icon {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    color: #888888;
    pointer-events: none;
    flex-shrink: 0;
  }

  .search-input:focus ~ .search-icon {
    color: #ff9500;
  }

  /* Mobile responsive */
  @media (max-width: 640px) {
    .search-input {
      font-size: 16px; /* Prevent zoom on mobile */
      padding: 14px 16px;
    }
  }
</style>
