---
import { withBase } from '../utils/paths';

const navItems = [
  { label: 'Home', href: withBase('/') },
  { label: 'Blog', href: withBase('/blog') },
  { label: 'About', href: withBase('/about') },
  { label: 'Resources', href: withBase('/resources') },
  { label: 'Reading', href: withBase('/reading') },
];

const currentPath = Astro.url.pathname;

const isActive = (href: string): boolean => {
  const home = withBase('/');
  if (href === home && (currentPath === home || currentPath === home.replace(/\/$/, ''))) {
    return true;
  }
  if (href !== home && currentPath.startsWith(href)) {
    return true;
  }
  return false;
};
---

<header class="sticky top-0 z-50 bg-dark-lighter border-b border-dark-border shadow-lg shadow-black/40">
  <nav class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" aria-label="Main">
    <div class="flex items-center justify-between h-16">
      <!-- Logo -->
      <a
        href={withBase('/')}
        class="text-xl sm:text-2xl font-bold text-light-text hover:text-accent-orange transition-colors duration-200 flex-shrink-0"
      >
        Jeremy Moore
      </a>

      <!-- Desktop Navigation -->
      <div class="hidden md:flex items-center gap-8">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`text-sm font-medium transition-colors duration-200 ${
                isActive(item.href)
                  ? 'text-accent-orange'
                  : 'text-light-text hover:text-accent-orange'
              }`}
            >
              {item.label}
            </a>
          ))
        }
      </div>

      <!-- Mobile Hamburger Menu -->
      <button
        type="button"
        id="mobile-menu-button"
        class="md:hidden text-light-text hover:text-accent-orange transition-colors duration-200 text-xl p-2 -mr-2"
        aria-label="Toggle menu"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <span class="mobile-menu-icon-open" aria-hidden="true">☰</span>
        <span class="mobile-menu-icon-close hidden" aria-hidden="true">✕</span>
      </button>
    </div>

    <!-- Mobile Navigation -->
    <div id="mobile-menu" class="mobile-menu hidden md:hidden pb-4" hidden>
      <div class="flex flex-col gap-1 border-t border-dark-border pt-3">
        {
          navItems.map((item) => (
            <a
              href={item.href}
              class={`block px-2 py-2 text-sm font-medium rounded transition-colors duration-200 ${
                isActive(item.href)
                  ? 'text-accent-orange bg-accent-orange/10'
                  : 'text-light-text hover:text-accent-orange hover:bg-dark-border/40'
              }`}
            >
              {item.label}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</header>

<script>
  const button = document.getElementById('mobile-menu-button');
  const menu = document.getElementById('mobile-menu');
  const openIcon = button?.querySelector('.mobile-menu-icon-open');
  const closeIcon = button?.querySelector('.mobile-menu-icon-close');

  if (button && menu && openIcon && closeIcon) {
    const setOpen = (open: boolean) => {
      button.setAttribute('aria-expanded', String(open));
      menu.classList.toggle('hidden', !open);
      menu.hidden = !open;
      openIcon.classList.toggle('hidden', open);
      closeIcon.classList.toggle('hidden', !open);
    };

    button.addEventListener('click', () => {
      setOpen(button.getAttribute('aria-expanded') !== 'true');
    });

    menu.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => setOpen(false));
    });

    window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
      if (event.matches) setOpen(false);
    });
  }
</script>

<style>
  .mobile-menu[hidden] {
    display: none;
  }
</style>
