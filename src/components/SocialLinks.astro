---
import { SOCIAL_LINKS } from '../config';

interface Props {
  size?: 'sm' | 'md' | 'lg';
  showLabels?: boolean;
}

const { size = 'md', showLabels = false } = Astro.props;

// Map sizes to Tailwind classes
const sizeMap = {
  sm: 'w-5 h-5',
  md: 'w-6 h-6',
  lg: 'w-8 h-8',
};

const iconSize = sizeMap[size];

// SVG icons
const GitHubIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v 3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/>
</svg>`;

const TwitterIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24h-6.6l-5.165-6.75-5.902 6.75H2.556l7.73-8.835L1.966 2.25h6.74l4.759 6.236L17.244 2.25zm-1.161 17.52h1.833L7.084 4.126H5.117z"/>
</svg>`;

const LinkedInIcon = `<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
  <path d="M16 8a6 6 0 016 6v7h-4v-7a2 2 0 00-2-2 2 2 0 00-2 2v7h-4v-7a6 6 0 016-6zM2 9h4v12H2z"/><circle cx="4" cy="4" r="2"/>
</svg>`;

const socialPlatforms = [
  {
    name: 'GitHub',
    url: SOCIAL_LINKS.github,
    icon: GitHubIcon,
    label: 'GitHub',
  },
  {
    name: 'Twitter',
    url: SOCIAL_LINKS.twitter,
    icon: TwitterIcon,
    label: 'Twitter',
  },
  {
    name: 'LinkedIn',
    url: SOCIAL_LINKS.linkedin,
    icon: LinkedInIcon,
    label: 'LinkedIn',
  },
];
---

<div class="flex items-center gap-4">
  {
    socialPlatforms.map((platform) => (
      <a
        href={platform.url}
        aria-label={platform.label}
        target="_blank"
        rel="noopener noreferrer"
        class={`text-light-text hover:text-accent-orange transition duration-200 ${iconSize}`}
      >
        <Fragment set:html={platform.icon} />
      </a>
    ))
  }
</div>

{
  showLabels && (
    <div class="flex items-center gap-4 mt-3">
      {socialPlatforms.map((platform) => (
        <a
          href={platform.url}
          target="_blank"
          rel="noopener noreferrer"
          class="text-sm text-light-text hover:text-accent-orange transition duration-200"
        >
          {platform.label}
        </a>
      ))}
    </div>
  )
}
