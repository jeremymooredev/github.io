---
interface Heading {
  depth: number;
  slug: string;
  text: string;
}

interface Props {
  headings: Heading[];
}

const { headings } = Astro.props;

// Filter to only h2 and h3 headings
const filteredHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
---

{
  filteredHeadings.length > 0 && (
    <div class="toc-card">
      <h3 class="toc-heading">Table of Contents</h3>
      <nav class="toc-nav">
        <ul class="toc-list">
          {filteredHeadings.map((heading) => (
            <li class={heading.depth === 3 ? 'toc-item-h3' : 'toc-item'}>
              <a href={`#${heading.slug}`} class="toc-link">
                {heading.text}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>
  )
}

<style>
  .toc-card {
    background: #1a1a1a;
    border: 1px solid #333333;
    border-radius: 0.5rem;
    padding: 1.5rem;
    margin-bottom: 2rem;
    position: sticky;
    top: 6rem;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
  }

  .toc-heading {
    color: #e0e0e0;
    font-size: 0.875rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    margin: 0 0 1rem 0;
  }

  .toc-nav {
    font-size: 0.875rem;
  }

  .toc-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .toc-item {
    margin-bottom: 0.5rem;
  }

  .toc-item-h3 {
    margin-bottom: 0.5rem;
    padding-left: 1rem;
  }

  .toc-link {
    color: #b0b0b0;
    text-decoration: none;
    transition: color 0.2s ease;
    display: block;
    padding: 0.25rem 0;
  }

  .toc-link:hover {
    color: #ff9500;
  }

  /* Scrollbar styling */
  .toc-card::-webkit-scrollbar {
    width: 6px;
  }

  .toc-card::-webkit-scrollbar-track {
    background: transparent;
  }

  .toc-card::-webkit-scrollbar-thumb {
    background: #333333;
    border-radius: 3px;
  }

  .toc-card::-webkit-scrollbar-thumb:hover {
    background: #444444;
  }
</style>
