---
interface Props {
  categories: string[];
  tags: string[];
}

const { categories, tags } = Astro.props;
const hasCategories = categories.length > 0;
const hasTags = tags.length > 0;
---

{
  (hasCategories || hasTags) && (
    <div class="post-filters" data-post-filters>
      {hasCategories && (
        <section class="filter-section">
          <h2 class="filter-heading">Categories</h2>
          <div class="filter-list" role="group" aria-label="Filter by category">
            <button
              type="button"
              class="filter-button active"
              data-filter-type="all"
              data-filter-value="all"
            >
              All Posts
            </button>
            {categories.map((category) => (
              <button
                type="button"
                class="filter-button"
                data-filter-type="category"
                data-filter-value={category}
              >
                {category}
              </button>
            ))}
          </div>
        </section>
      )}

      {hasTags && (
        <section class="filter-section">
          <h2 class="filter-heading">Tags</h2>
          <div class="filter-list filter-list-tags" role="group" aria-label="Filter by tag">
            {tags.map((tag) => (
              <button
                type="button"
                class="filter-button filter-button-tag"
                data-filter-type="tag"
                data-filter-value={tag}
              >
                {tag}
              </button>
            ))}
          </div>
        </section>
      )}
    </div>
  )
}

<style>
  .post-filters {
    width: 100%;
    background-color: #1a1a1a;
    border: 1px solid #333333;
    border-radius: 0.5rem;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .filter-section {
    display: flex;
    flex-direction: column;
    gap: 0.625rem;
  }

  .filter-heading {
    font-size: 0.75rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.13em;
    color: #999999;
    margin: 0;
    padding: 0;
  }

  .filter-list {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
  }

  .filter-list-tags {
    flex-direction: row;
    flex-wrap: wrap;
  }

  .filter-button {
    padding: 0.625rem 0.875rem;
    background: transparent;
    border: 1px solid #2a2a2a;
    border-radius: 0.375rem;
    color: #d4d4d4;
    font-size: 0.9rem;
    font-weight: 500;
    cursor: pointer;
    text-align: left;
    transition: all 0.2s ease-out;
    font-family: inherit;
  }

  .filter-button-tag {
    text-align: center;
    padding: 0.4rem 0.75rem;
    font-size: 0.85rem;
  }

  .filter-button:hover {
    background-color: #242424;
    border-color: #3a3a3a;
    color: #e0e0e0;
  }

  .filter-button.active {
    background-color: #ff9500;
    color: #0f0f0f;
    font-weight: 600;
    border-color: #ff9500;
  }

  .filter-button.active:hover {
    background-color: #ffab1a;
    border-color: #ffab1a;
  }

  @media (max-width: 640px) {
    .post-filters {
      background-color: transparent;
      border: none;
      padding: 0.5rem 0;
    }

    .filter-list:not(.filter-list-tags) {
      flex-direction: row;
      flex-wrap: wrap;
    }

    .filter-list:not(.filter-list-tags) .filter-button {
      flex: 1 1 auto;
      min-width: 70px;
      text-align: center;
    }
  }

  @media (max-width: 375px) {
    .filter-list:not(.filter-list-tags) {
      flex-direction: column;
    }

    .filter-list:not(.filter-list-tags) .filter-button {
      min-width: auto;
      width: 100%;
    }
  }
</style>

<script>
  type FilterType = 'all' | 'category' | 'tag';

  function applyPostFilter(type: FilterType, value: string) {
    const posts = document.querySelectorAll<HTMLElement>('[data-post-category]');
    const emptyState = document.getElementById('post-list-empty');
    let visibleCount = 0;

    posts.forEach((post) => {
      const category = post.getAttribute('data-post-category') ?? '';
      const tagList = (post.getAttribute('data-post-tags') ?? '')
        .split(',')
        .map((t) => t.trim())
        .filter(Boolean);

      let show = false;
      if (type === 'all') {
        show = true;
      } else if (type === 'category') {
        show = category === value;
      } else {
        show = tagList.includes(value);
      }

      post.style.display = show ? '' : 'none';
      if (show) visibleCount++;
    });

    if (emptyState) {
      emptyState.hidden = visibleCount > 0;
    }

    const params = new URLSearchParams(window.location.search);
    if (type === 'all') {
      params.delete('category');
      params.delete('tag');
    } else if (type === 'category') {
      params.set('category', value);
      params.delete('tag');
    } else {
      params.set('tag', value);
      params.delete('category');
    }
    const query = params.toString();
    const url = query ? `${window.location.pathname}?${query}` : window.location.pathname;
    history.replaceState(null, '', url);
  }

  function setActiveButton(container: Element, active: Element) {
    container.querySelectorAll('.filter-button').forEach((btn) => {
      btn.classList.remove('active');
    });
    active.classList.add('active');
  }

  function initFromUrl(container: Element) {
    const params = new URLSearchParams(window.location.search);
    const category = params.get('category');
    const tag = params.get('tag');

    if (category) {
      const btn = container.querySelector(
        `[data-filter-type="category"][data-filter-value="${CSS.escape(category)}"]`,
      );
      if (btn) {
        setActiveButton(container, btn);
        applyPostFilter('category', category);
        return;
      }
    }

    if (tag) {
      const btn = container.querySelector(
        `[data-filter-type="tag"][data-filter-value="${CSS.escape(tag)}"]`,
      );
      if (btn) {
        setActiveButton(container, btn);
        applyPostFilter('tag', tag);
        return;
      }
    }
  }

  document.addEventListener('DOMContentLoaded', () => {
    const container = document.querySelector('[data-post-filters]');
    if (!container) return;

    container.querySelectorAll('.filter-button').forEach((button) => {
      button.addEventListener('click', () => {
        const type = button.getAttribute('data-filter-type') as FilterType;
        const value = button.getAttribute('data-filter-value') ?? '';
        setActiveButton(container, button);
        applyPostFilter(type, value);
      });
    });

    initFromUrl(container);
  });
</script>
