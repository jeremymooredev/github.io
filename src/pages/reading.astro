---
import Layout from '../layouts/Layout.astro';
import readingData from '../../development-reading-list.json';

interface Book {
  title: string;
  author: string;
  published: number;
  pages: number;
  genres: string[];
  isbn: string;
  purchased: string;
  status: string;
  reading_period: {
    started?: string;
    finished?: string;
    acquired?: string;
  };
  cover: string;
}

const books = readingData.reading_list as Book[];

const readingBooks = books
  .filter((b) => b.status === 'reading')
  .sort((a, b) => {
    const aDate = a.reading_period?.acquired || a.reading_period?.started || '0';
    const bDate = b.reading_period?.acquired || b.reading_period?.started || '0';
    return bDate.localeCompare(aDate);
  });

const completedBooks = books
  .filter((b) => b.status === 'completed')
  .sort((a, b) => {
    const aDate = a.reading_period?.finished || '0';
    const bDate = b.reading_period?.finished || '0';
    return bDate.localeCompare(aDate);
  });

const fmtDate = (d: string | undefined) => {
  if (!d) return '';
  const [y, m] = d.split('-').map(Number);
  return new Date(y, m - 1).toLocaleDateString('en-US', { month: 'short', year: 'numeric' });
};
---

<Layout title="Reading List | Jeremy Moore" description="Books I'm currently reading and have finished">
  <div class="max-w-5xl mx-auto px-4 py-12">

    <section class="mb-12">
      <h1 class="text-4xl font-bold text-light-text mb-3">Reading List</h1>
      <p class="text-gray-400 mb-2">Books I'm working through and have finished.</p>
      <p class="text-sm text-gray-500 mb-6">
      <a href="5NS%252bUfKz0EyShW6gzUWrEw%253d%253d" target="_blank">I pick up most of my books from ThriftBooks. I think I'm addicted 🤣</a>
      <br>Get a free book when you sign up for ReadingRewards and spend $30.
      </p>
      <div class="flex gap-8 text-sm">
        <span class="text-gray-500">
          <span class="text-light-text font-semibold">{completedBooks.length}</span> finished
        </span>
        <span class="text-gray-500">
          <span class="text-light-text font-semibold">{readingBooks.length}</span> in progress
        </span>
      </div>
    </section>

    {readingBooks.length > 0 && (
      <section class="mb-14">
        <h2 class="text-2xl font-bold text-accent-orange mb-6">Currently Reading</h2>
        <div class="grid gap-5 sm:grid-cols-2">
          {readingBooks.map((book) => (
            <div class="flex gap-5 p-5 bg-dark-lighter border border-gray-700 rounded-lg hover:border-accent-orange/40 transition-colors duration-200">
              <img
                src={book.cover}
                alt={book.title}
                class="w-16 flex-shrink-0 rounded shadow-md self-start"
                loading="lazy"
              />
              <div class="flex-1 min-w-0">
                <div class="flex items-start justify-between gap-3 mb-1.5">
                  <h3 class="text-base font-bold text-light-text leading-snug">{book.title}</h3>
                  <span class="text-xs font-semibold text-accent-orange border border-accent-orange/30 bg-accent-orange/10 px-2 py-0.5 rounded whitespace-nowrap flex-shrink-0">
                    Reading
                  </span>
                </div>
                <p class="text-sm text-gray-400 mb-3">
                  {book.author} · {book.published}
                </p>
                <div class="flex flex-wrap gap-1.5">
                  {book.genres.map((genre) => (
                    <span class="text-xs text-gray-500 border border-gray-700 px-2 py-0.5 rounded">
                      {genre}
                    </span>
                  ))}
                </div>
                {(book.reading_period?.started || book.reading_period?.acquired) && (
                  <p class="text-xs text-gray-600 mt-2">
                    Started {fmtDate(book.reading_period.started || book.reading_period.acquired)}
                  </p>
                )}
              </div>
            </div>
          ))}
        </div>
      </section>
    )}

    {completedBooks.length > 0 && (
      <section>
        <h2 class="text-2xl font-bold text-accent-orange mb-6">Finished</h2>
        <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-5 gap-5">
          {completedBooks.map((book) => (
            <div class="group">
              <div class="mb-2.5 rounded overflow-hidden border border-gray-700 group-hover:border-gray-600 transition-colors duration-200 aspect-[2/3] bg-dark-lighter">
                <img
                  src={book.cover}
                  alt={book.title}
                  class="w-full h-full object-cover block"
                  loading="lazy"
                />
              </div>
              <h3 class="text-sm font-bold text-light-text leading-snug mb-0.5">{book.title}</h3>
              <p class="text-xs text-gray-400 mb-1">{book.author}</p>
              {book.reading_period?.finished && (
                <p class="text-xs text-gray-600">{fmtDate(book.reading_period.finished)}</p>
              )}
            </div>
          ))}
        </div>
      </section>
    )}

  </div>
</Layout>
