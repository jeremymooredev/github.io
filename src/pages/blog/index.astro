---
import Layout from '../../layouts/Layout.astro';
import PostList from '../../components/PostList.astro';
import Sidebar from '../../components/Sidebar.astro';
import { getCollection } from 'astro:content';
import { getActiveCategories, getActiveTags } from '../../utils/posts';

const allPosts = await getCollection('blog');

const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const activeCategories = getActiveCategories(sortedPosts);
const activeTags = getActiveTags(sortedPosts);
---

<Layout title="Blog | Jeremy Moore" description="Web development tips, Linux guides, and DevOps insights">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <div class="grid grid-cols-1 lg:grid-cols-4 gap-8">
      <div class="lg:col-span-1 lg:sticky lg:top-24 h-fit">
        <Sidebar categories={activeCategories} tags={activeTags} />
      </div>

      <div class="lg:col-span-3">
        <section>
          {sortedPosts.length === 0 ? (
            <div class="text-center py-12">
              <p class="text-gray-400 text-lg">No blog posts yet.</p>
            </div>
          ) : (
            <PostList posts={sortedPosts} />
          )}
        </section>
      </div>
    </div>
  </div>
</Layout>
