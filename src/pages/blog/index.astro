---
import Layout from '../../layouts/Layout.astro';
import BlogCard from '../../components/BlogCard.astro';
import Sidebar from '../../components/Sidebar.astro';
import { formatDate, getReadingTime, extractExcerpt } from '../../utils/formatting';
import { getCollection } from 'astro:content';

// Fetch all blog posts
const allPosts = await getCollection('blog');

// Sort by date (newest first)
const sortedPosts = allPosts.sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);
---

<Layout title="Blog | Jeremy Moore" description="Web development tips, Linux guides, and DevOps insights">
  <div class="max-w-6xl mx-auto px-4 py-12">
    <!-- Page Title -->
    <section class="mb-12 max-w-2xl">
      <h1 class="text-4xl sm:text-5xl font-bold text-light-text mb-4">
        Blog
      </h1>
      <p class="text-lg text-gray-400">
        Exploring web development, Linux systems, and DevOps practices.
      </p>
    </section>

    <!-- Main Grid Layout -->
    <div class="grid grid-cols-1 lg:grid-cols-3 gap-8">
      <!-- Left Column: Blog Posts -->
      <div class="lg:col-span-2 max-w-2xl">
        <section>
          <div class="space-y-4">
            {sortedPosts.map((post) => (
              <BlogCard
                title={post.data.title}
                excerpt={post.data.excerpt || extractExcerpt(post.body)}
                date={post.data.date}
                category={post.data.category}
                image={post.data.image}
                slug={post.slug}
                readingTime={`${getReadingTime(post.body)} min read`}
                tags={post.data.tags}
              />
            ))}
          </div>

          {sortedPosts.length === 0 && (
            <div class="text-center py-12">
              <p class="text-gray-400 text-lg">No blog posts yet.</p>
            </div>
          )}
        </section>
      </div>

      <!-- Right Column: Sidebar -->
      <div class="lg:col-span-1">
        <Sidebar />
      </div>
    </div>
  </div>
</Layout>
