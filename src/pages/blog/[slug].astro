---
import { getCollection } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPost.astro';
import { getReadingTime } from '../../utils/formatting';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => {
    return {
      params: { slug: post.id.replace(/\.\w+$/, '') },
      props: { post },
    };
  });
}

interface Props {
  post: any;
}

const { post } = Astro.props;

// Calculate reading time
const readingTime = getReadingTime(post.body);

// Extract headings from markdown
const headingRegex = /^(#{2,3})\s+(.+)$/gm;
const headings: any[] = [];
let match;

while ((match = headingRegex.exec(post.body)) !== null) {
  const level = match[1].length;
  const text = match[2];
  const slug = text
    .toLowerCase()
    .trim()
    .replace(/[^\w\s-]/g, '')
    .replace(/[\s_]+/g, '-')
    .replace(/^-+|-+$/g, '');

  headings.push({
    depth: level,
    slug: slug,
    text: text,
  });
}

// Convert markdown to HTML - proper order of operations for lists
const convertMarkdownToHtml = (md: string): string => {
  let html = md;

  // Headers first (before other processing)
  html = html.replace(/^### (.*?)$/gm, '<h3 id="$1-id">$1</h3>');
  html = html.replace(/^## (.*?)$/gm, '<h2 id="$1-id">$1</h2>');
  html = html.replace(/^# (.*?)$/gm, '<h1>$1</h1>');

  // Lists BEFORE line breaks so they're not wrapped in <p> tags
  // Handle unordered lists with -
  html = html.replace(/^\s*-\s+(.+)$/gm, '<li>$1</li>');
  // Handle unordered lists with *
  html = html.replace(/^\s*\*\s+(.+)$/gm, '<li>$1</li>');
  // Wrap consecutive <li> tags in <ul> - match 1+ <li> items with optional whitespace between
  html = html.replace(/(<li>[\s\S]*?<\/li>(\s*<li>[\s\S]*?<\/li>)*)/g, '<ul>$1</ul>');

  // Code blocks (before line breaks)
  html = html.replace(/```(.*?)\n(.*?)```/gs, '<pre><code>$2</code></pre>');

  // Blockquotes (before line breaks)
  html = html.replace(/^>\s+(.+)$/gm, '<blockquote>$1</blockquote>');

  // Bold and italic
  html = html.replace(/\*\*(.*?)\*\*/g, '<strong>$1</strong>');
  html = html.replace(/__(.*?)__/g, '<strong>$1</strong>');
  html = html.replace(/\*(.*?)\*/g, '<em>$1</em>');
  html = html.replace(/_(.*?)_/g, '<em>$1</em>');

  // Links
  html = html.replace(/\[(.*?)\]\((.*?)\)/g, '<a href="$2">$1</a>');

  // Inline code
  html = html.replace(/`([^`]+)`/g, '<code>$1</code>');

  // Line breaks - wrap remaining text in paragraphs
  html = html.replace(/\n\n/g, '</p><p>');
  // Don't wrap already-wrapped elements in paragraphs
  html = html.replace(/<p>(<(?:h[1-3]|ul|pre|blockquote))/g, '<$1');
  html = html.replace(/(<\/(?:h[1-3]|ul|pre|blockquote)>)<\/p>/g, '$1');
  // Wrap remaining text
  html = '<p>' + html + '</p>';
  // Clean up any empty paragraphs
  html = html.replace(/<p><\/p>/g, '');

  return html;
};

const htmlContent = convertMarkdownToHtml(post.body);

// Get all posts for finding related ones
const allPosts = await getCollection('blog');

// Find related posts based on category or tags
const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .filter(
    (p) =>
      p.data.category === post.data.category ||
      p.data.tags.some((tag: string) => post.data.tags.includes(tag)),
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4)
  .map((p) => ({
    slug: p.id.replace(/\.\w+$/, ''),
    data: {
      title: p.data.title,
      excerpt: p.data.excerpt,
    },
  }));
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  frontmatter={post.data}
  headings={headings}
  readingTime={`${readingTime} min read`}
  relatedPosts={relatedPosts}
>
  <Fragment set:html={htmlContent} />
</BlogPostLayout>
