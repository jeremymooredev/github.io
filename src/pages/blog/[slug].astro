---
import { getCollection, render } from 'astro:content';
import BlogPostLayout from '../../layouts/BlogPost.astro';
import { getReadingTime } from '../../utils/formatting';

export async function getStaticPaths() {
  const posts = await getCollection('blog');

  return posts.map((post) => {
    return {
      params: { slug: post.id.replace(/\.\w+$/, '') },
      props: { post },
    };
  });
}

interface Props {
  post: Awaited<ReturnType<typeof getCollection<'blog'>>>[number];
}

const { post } = Astro.props;

const { Content, headings } = await render(post);
const readingTime = getReadingTime(post.body);

const allPosts = await getCollection('blog');

const relatedPosts = allPosts
  .filter((p) => p.id !== post.id)
  .filter(
    (p) =>
      p.data.category === post.data.category ||
      p.data.tags.some((tag: string) => post.data.tags.includes(tag)),
  )
  .sort((a, b) => b.data.date.getTime() - a.data.date.getTime())
  .slice(0, 4)
  .map((p) => ({
    slug: p.id.replace(/\.\w+$/, ''),
    data: {
      title: p.data.title,
      excerpt: p.data.excerpt,
    },
  }));
---

<BlogPostLayout
  title={post.data.title}
  description={post.data.description}
  frontmatter={post.data}
  headings={headings}
  readingTime={`${readingTime} min read`}
  relatedPosts={relatedPosts}
>
  <Content />
</BlogPostLayout>
